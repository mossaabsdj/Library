generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Product {
  id              Int       @id @default(autoincrement()) @map("Produit_ID")
  primaryBarcode  String?   @unique @map("Code_Barre")
  reference       String?   @map("Refference")
  name            String    @map("Nom")
  unitPrice       Decimal   @map("Prix_Unit") @db.Decimal(12, 2)
  stockQuantity   Int       @default(0) @map("Stock_Q")
  purchasePrice   Decimal?  @map("Prix_Achat") @db.Decimal(12, 2)
  salesRapid      Boolean   @default(false) @map("Sales_Rapid")
  image           String?   @map("Image") @db.VarChar(500)
  category        String?   @map("Categorie")

  // Additional fields
  minimumStock    Int       @default(5)
  description     String?   @db.Text
  unit            String    @default("piece")
  taxRate         Decimal   @default(0) @db.Decimal(5, 2)
  discount        Decimal   @default(0) @db.Decimal(5, 2)
  brand           String?
  isActive        Boolean   @default(true)
  supplierId      Int?
  supplier        Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  barcodes           Barcode[]
  saleItems          SaleItem[]
  purchaseItems      PurchaseItem[]
  inventoryMovements InventoryMovement[]

  @@index([name])
  @@index([reference])
  @@index([primaryBarcode])
  @@index([category])
  @@map("produit")
}

model Barcode {
  id        Int     @id @default(autoincrement()) @map("Code_Barre_ID")
  productId Int     @map("Produit_ID")
  code      String  @unique @map("Code_Barre")

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([code])
  @@index([productId])
  @@map("code_barres")
}

model Customer {
  id          Int       @id @default(autoincrement())
  fullName    String    @map("name")
  phone       String?
  email       String?
  address     String?
  notes       String?   @db.Text
  creditLimit Decimal   @default(0) @db.Decimal(12, 2)
  credit      Decimal   @default(0) @db.Decimal(12, 2) // Current debt owed by customer
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sales       Sale[]
  payments    Payment[]

  @@index([phone])
  @@index([fullName])
  @@map("client")
}

model Supplier {
  id        Int       @id @default(autoincrement())
  name      String
  phone     String?
  email     String?
  address   String?
  company   String?
  notes     String?   @db.Text
  debt      Decimal   @default(0) @db.Decimal(12, 2) // Current debt owed to supplier
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  products  Product[]
  purchases Purchase[]
  payments  Payment[]

  @@index([phone])
  @@index([name])
  @@map("fournisseur")
}

model Sale {
  id              Int         @id @default(autoincrement())
  invoiceNumber   String      @unique
  date            DateTime    @default(now())
  totalAmount     Decimal     @db.Decimal(12, 2)
  discountAmount  Decimal     @default(0) @db.Decimal(12, 2)
  taxAmount       Decimal     @default(0) @db.Decimal(12, 2)
  finalAmount     Decimal     @db.Decimal(12, 2)
  paidAmount      Decimal     @db.Decimal(12, 2)
  remainingAmount Decimal     @default(0) @db.Decimal(12, 2) // Customer debt
  paymentMethod   String      @default("CASH") // CASH, CARD, CREDIT, OTHER
  status          String      @default("COMPLETED") // COMPLETED, HELD, RETURNED, PARTIAL_RETURN
  notes           String?     @db.Text
  cashierName     String?     @default("Admin")

  customerId      Int?
  customer        Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  items           SaleItem[]
  payments        Payment[]

  @@index([invoiceNumber])
  @@index([date])
  @@index([customerId])
  @@index([createdAt])
  @@map("vente")
}

model SaleItem {
  id            Int      @id @default(autoincrement())
  saleId        Int
  productId     Int
  unitPrice     Decimal  @db.Decimal(12, 2)
  purchasePrice Decimal  @default(0) @db.Decimal(12, 2) // To calculate exact margin at sale time
  quantity      Int
  discount      Decimal  @default(0) @db.Decimal(12, 2)
  subtotal      Decimal  @db.Decimal(12, 2)

  sale          Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product       Product  @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
  @@map("ventprod")
}

model Purchase {
  id              Int            @id @default(autoincrement())
  invoiceNumber   String         @unique
  date            DateTime       @default(now())
  totalAmount     Decimal        @db.Decimal(12, 2)
  paidAmount      Decimal        @db.Decimal(12, 2)
  remainingAmount Decimal        @default(0) @db.Decimal(12, 2) // Supplier debt
  paymentStatus   String         @default("PAID") // PAID, PARTIAL, UNPAID
  notes           String?        @db.Text

  supplierId      Int
  supplier        Supplier       @relation(fields: [supplierId], references: [id])

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  items           PurchaseItem[]
  payments        Payment[]

  @@index([invoiceNumber])
  @@index([supplierId])
  @@index([date])
  @@index([createdAt])
  @@map("facture")
}

model PurchaseItem {
  id            Int      @id @default(autoincrement())
  purchaseId    Int
  productId     Int
  purchasePrice Decimal  @db.Decimal(12, 2)
  quantity      Int
  subtotal      Decimal  @db.Decimal(12, 2)

  purchase      Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product       Product  @relation(fields: [productId], references: [id])

  @@index([purchaseId])
  @@index([productId])
  @@map("factprod")
}

enum MovementType {
  PURCHASE
  SALE
  SALE_RETURN
  PURCHASE_RETURN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  INITIAL_STOCK
}

model InventoryMovement {
  id            Int          @id @default(autoincrement())
  productId     Int
  quantity      Int
  previousStock Int
  newStock      Int
  type          MovementType
  reference     String?      // E.g. Sale invoice # or Purchase invoice #
  user          String?      @default("Admin")
  notes         String?      @db.Text
  createdAt     DateTime     @default(now())

  product       Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([type])
  @@index([createdAt])
  @@map("mouvements_stock")
}

model Payment {
  id            Int       @id @default(autoincrement())
  type          String    // CUSTOMER_DEBT_PAYMENT, SUPPLIER_DEBT_PAYMENT, SALE_PAYMENT, PURCHASE_PAYMENT
  amount        Decimal   @db.Decimal(12, 2)
  paymentMethod String    @default("CASH") // CASH, CARD, CHECK, BANK_TRANSFER
  notes         String?   @db.Text
  date          DateTime  @default(now())
  createdAt     DateTime  @default(now())

  customerId    Int?
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  supplierId    Int?
  supplier      Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  saleId        Int?
  sale          Sale?     @relation(fields: [saleId], references: [id], onDelete: SetNull)

  purchaseId    Int?
  purchase      Purchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([supplierId])
  @@index([date])
  @@map("paiement")
}

model Expense {
  id            Int      @id @default(autoincrement())
  title         String
  category      String   // RENT, ELECTRICITY, TRANSPORT, SALARY, MAINTENANCE, OTHER
  amount        Decimal  @db.Decimal(12, 2)
  paymentMethod String   @default("CASH")
  notes         String?  @db.Text
  date          DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([category])
  @@index([date])
  @@map("depenses")
}

model Setting {
  id                 Int      @id @default(1)
  storeName          String   @default("Mon Magasin / متجري")
  phone              String?  @default("0550 00 00 00")
  email              String?
  address            String?  @default("Alger, Algérie")
  currency           String   @default("DA")
  taxRate            Decimal  @default(0) @db.Decimal(5, 2)
  receiptHeader      String?  @default("Bienvenue / مرحبا بكم")
  receiptFooter      String?  @default("Merci pour votre visite! / شكراً لزيارتكم")
  lowStockThreshold  Int      @default(5)
  enableSoundEffects Boolean  @default(true)
  enableBarcodeBeep  Boolean  @default(true)
  allowNegativeStock Boolean  @default(false)
  themeMode          String   @default("light")
  themeColor         String   @default("blue")
  updatedAt          DateTime @updatedAt

  @@map("reglages")
}

